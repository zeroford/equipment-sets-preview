<%
  require 'json'

  # NOTE: ข้อมูลสำรองตอน Web App โหลดไม่ได้เท่านั้น — ตัวจริงมาจาก Google Sheet
  # รูปแบบเดียวกับที่ Web App ส่งมา เก็บเท่าที่จำเป็นจริงๆ:
  #   grade  9 = legendary, 10 = eternal
  #   base   ค่า base stat (ชนิดของมันผูกกับ slot อยู่แล้ว → assets/js/catalog.mjs)
  #   subs   [[stat id, ค่า], …] — id ดู assets/js/stats.mjs
  #   percent เก็บเป็นเศษส่วน (0.0853 = 8.53%)
  # ชื่อของก็ไม่ต้องเก็บ — ผูกกับ (slot, grade) อยู่แล้ว
  Item = Struct.new(:level, :grade, :power, :base, :subs)

  sets = [
    {
      set_key: 'boss',
      title: 'Set A',
      items: [
        Item.new(97, 10, 287.59, 6043, [['skillAmp', 0.0853], ['critDmg', 0.1462]]),
        Item.new(98, 10, 218.42, 475.6, [['skillAmp', 0.0871], ['accuracy', 160.91]]),
        Item.new(101, 10, 185.72, 0.3649, [['skillAmp', 0.0885], ['critDmg', 0.1239]]),
        Item.new(99, 10, 103.56, 4809, [['dmgReduction', 0.0433], ['critRes', 0.1462]]),
        Item.new(99, 9, 209.31, 62614, [['dmgReduction', 0.0343], ['critRes', 0.1329]]),
        Item.new(97, 10, 250.07, 471.5, [['dmgReduction', 0.0621], ['critRes', 0.206]]),
        Item.new(99, 9, 179.87, 0.3304, [['skillAmp', 0.0731], ['focus', 167.72]]),
        Item.new(94, 10, 213.84, 455.1, [['critRate', 0.2125], ['skillAmp', 0.092]]),
        Item.new(97, 10, 209.82, 471.5, [['accuracy', 151.5], ['skillAmp', 0.0862]]),
        Item.new(101, 10, 179.85, 0.2747, [['dmgReduction', 0.0609], ['critRes', 0.2182]]),
        Item.new(100, 10, 152.61, 0.1338, [['focus', 214.46], ['skillHaste', 4.6]]),
        Item.new(96, 10, 155.27, 0.1148, [['dmgReduction', 0.063], ['resistance', 140.08]]),
      ],
    },
    {
      set_key: 'pve',
      title: 'Set B',
      items: [
        Item.new(94, 9, 184.58, 5196, [['skillAmp', 0.0729], ['accuracy', 110.54]]),
        Item.new(89, 9, 125.07, 403.59, [['skillAmp', 0.0717], ['accuracy', 135.48]]),
        Item.new(91, 10, 119.28, 0.3075, [['critDmg', 0.1265], ['accuracy', 157.18]]),
        Item.new(93, 10, 73.94, 3963, [['dmgReduction', 0.0476], ['critRes', 0.1252]]),
        Item.new(94, 10, 143.46, 62109, [['evasion', 54.63], ['dmgReduction', 0.0436]]),
        nil,
        Item.new(96, 10, 135.2, 0.3362, [['focus', 191.38], ['skillHaste', 4.6]]),
        Item.new(95, 9, 113.99, 430.5, [['skillAmp', 0.0708], ['accuracy', 143.99]]),
        Item.new(93, 9, 148.09, 422.81, [['resistance', 77.94], ['skillAmp', 0.0731]]),
        nil,
        Item.new(85, 9, 110.69, 0.0961, [['focus', 176.64], ['critRes', 0.1639]]),
        Item.new(90, 9, 110.74, 0.0959, [['focus', 187.04], ['critRes', 0.149]]),
      ],
    },
    {
      set_key: 'set3',
      title: 'Set C',
      items: Array.new(12),
    },
  ]

  equipment_sets_json = sets.map do |set|
    {
      'setKey' => set[:set_key],
      'title' => set[:title],
      'items' => set[:items].map do |item|
        next unless item

        {
          'level' => item.level,
          'grade' => item.grade,
          'power' => item.power,
          'base' => item.base,
          'subs' => item.subs,
        }
      end,
    }
  end.to_json

  # NOTE: URL นี้เป็น public read-only endpoint โดยตั้งใจ (Who has access: Anyone)
  # ไม่ใช่ความลับ — ใครเปิดหน้าเว็บก็เห็นใน HTML อยู่แล้ว
  sheets_config_json = {
    'webAppUrl' =>
      'https://script.google.com/macros/s/AKfycbw7PadlOwS_HfJKhU9g8Tacz-fPNewAbdV4JvLMsu_iHrfDAAzXEUWpceiuad1EDfVo/exec',
  }.to_json
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Equipment Sets</title>
  <style>
    :root {
      --bg: #0f1114;
      --card: #2a2e33;
      --text: #f1f3f5;
      --muted: #868e96;
      --divider: rgba(255, 255, 255, 0.08);
      --dock-bottom: calc(0.65rem + env(safe-area-inset-bottom, 0px));
      --dock-scroll-pad: calc(4.35rem + env(safe-area-inset-bottom, 0px));
    }

    .glass-chip {
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(22, 24, 28, 0.72);
      backdrop-filter: blur(20px) saturate(1.2);
      -webkit-backdrop-filter: blur(20px) saturate(1.2);
      box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 2rem 1.5rem var(--dock-scroll-pad);
    }

    .page { max-width: 1200px; margin: 0 auto; }

    .section[hidden] {
      display: none !important;
    }

    .set-tabs {
      position: fixed;
      left: 50%;
      bottom: var(--dock-bottom);
      z-index: 1001;
      width: min(calc((100vw - 2rem) * 0.7), 364px);
      transform: translateX(-50%);
      pointer-events: none;
    }

    .set-tabs-list:empty {
      display: none;
    }
    .set-tabs-list {
      display: flex;
      width: 100%;
      height: 3.25rem;
      box-sizing: border-box;
      align-items: stretch;
      gap: 0.25rem;
      padding: 0.25rem;
      border-radius: 999px;
      pointer-events: auto;
    }

    .set-tabs-list.glass-chip {
      border-radius: 999px;
    }

    .set-tab {
      position: relative;
      flex: 1 1 0;
      min-width: 0;
      min-height: 0;
      margin: 0;
      padding: 0 0.65rem;
      border: none;
      border-radius: 999px;
      background: transparent;
      color: #868e96;
      font: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.25;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: color 0.15s ease;
      z-index: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .set-tab-label {
      position: relative;
      z-index: 1;
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .set-tab-indicator {
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background: #3d4450;
      box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
      opacity: 0;
      transition: opacity 0.15s ease;
      z-index: 0;
    }

    .set-tab[aria-selected="true"] {
      color: #f1f3f5;
    }

    .set-tab[aria-selected="true"] .set-tab-indicator {
      opacity: 1;
    }

    .set-tab:hover:not([aria-selected="true"]) {
      color: #ced4da;
    }

    .set-tab:focus-visible {
      outline: 2px solid #a78bfa;
      outline-offset: 2px;
    }

    .dock-fab {
      width: 3.25rem;
      height: 3.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 0;
      border: none;
      color: #f1f3f5;
      border-radius: 50%;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .dock-fab.glass-chip {
      border-radius: 50%;
    }

    .dock-fab:hover {
      color: #fff;
      transform: scale(1.05);
    }

    .dock-fab svg,
    .dock-fab .lucide {
      display: block;
      width: 1.35rem;
      height: 1.35rem;
    }

    /* ── toggle PvE / Boss ลอยมุมขวาบน ───────────────────────── */
    .mode-toggle {
      position: fixed;
      top: calc(0.75rem + env(safe-area-inset-top, 0px));
      right: 0.75rem;
      z-index: 1002;
      display: flex;
      gap: 0.15rem;
      padding: 0.2rem;
      border-radius: 999px;
    }
    .mode-toggle[hidden] {
      display: none;
    }
    .mode-option {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.7rem;
      border: none;
      border-radius: 999px;
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .mode-option:hover {
      color: var(--text);
    }
    .mode-option[aria-pressed="true"] {
      background: #3d4450;
      color: #f1f3f5;
      box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .mode-option svg,
    .mode-option .lucide {
      display: block;
      width: 0.9rem;
      height: 0.9rem;
    }

    /* ── ระหว่างรอ API ────────────────────────────────────────── */
    .page-loading {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .page-loading-spinner {
      width: 3rem;
      height: 3rem;
      border: 3px solid rgba(255, 255, 255, 0.14);
      border-top-color: rgba(255, 255, 255, 0.55);
      border-radius: 50%;
      animation: page-spin 0.7s linear infinite;
    }
    @keyframes page-spin {
      to {
        transform: rotate(360deg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .page-loading-spinner {
        animation-duration: 2.4s;
      }
    }

    /* ── โหมดแก้ไข ───────────────────────────────────────────── */
    .edit-fab {
      position: fixed;
      right: 1rem;
      left: auto;
      bottom: calc(var(--dock-bottom) + 3.85rem);
      z-index: 1002;
    }
    .edit-fab[hidden] {
      display: none !important;
    }
    .edit-fab[aria-pressed="true"] {
      background: rgba(255, 255, 255, 0.38);
      border-color: rgba(255, 255, 255, 0.42);
      color: #fff;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.45),
        0 1px 3px rgba(0, 0, 0, 0.22);
    }
    /* การ์ดกดได้เฉพาะตอนเปิดโหมดแก้ไข */
    body.is-editing .card,
    body.is-editing .grid-empty {
      cursor: pointer;
      outline: 1px dashed rgba(255, 255, 255, 0.28);
      outline-offset: 2px;
    }
    body.is-editing .card:hover,
    body.is-editing .grid-empty:hover {
      outline-color: rgba(255, 255, 255, 0.6);
    }

    .edit-dialog {
      width: min(26rem, calc(100vw - 2rem));
      padding: 0;
      border: none;
      border-radius: 1rem;
      background: var(--card);
      color: var(--text);
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
    }
    .edit-dialog::backdrop {
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(3px);
    }
    .edit-dialog form {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      padding: 1.15rem;
    }
    .edit-title {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
    }
    .edit-sub {
      margin: -0.55rem 0 0;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .edit-row {
      display: grid;
      grid-template-columns: 6.5rem 1fr;
      align-items: center;
      gap: 0.6rem;
    }
    .edit-row.edit-row-pair {
      grid-template-columns: 6.5rem 1fr 6.5rem;
    }
    .edit-row > label {
      font-size: 0.8rem;
      color: var(--muted);
    }
    .edit-dialog input,
    .edit-dialog select {
      width: 100%;
      padding: 0.45rem 0.6rem;
      border: 1px solid var(--divider);
      border-radius: 0.5rem;
      background: rgba(0, 0, 0, 0.28);
      color: var(--text);
      font: inherit;
      font-size: 0.85rem;
    }
    .edit-dialog input:focus,
    .edit-dialog select:focus {
      outline: 2px solid rgba(255, 255, 255, 0.45);
      outline-offset: 1px;
    }
    .edit-actions {
      display: flex;
      gap: 0.5rem;
      justify-content: flex-end;
      margin-top: 0.25rem;
    }
    .edit-actions button {
      padding: 0.5rem 0.95rem;
      border: 1px solid var(--divider);
      border-radius: 0.5rem;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text);
      font: inherit;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .edit-actions button[value="save"] {
      background: #3d4450;
      border-color: rgba(255, 255, 255, 0.18);
      color: #f1f3f5;
      font-weight: 600;
    }
    .edit-actions button[value="clear"] {
      margin-right: auto;
      color: #ff8787;
    }
    .edit-actions button[disabled] {
      opacity: 0.55;
      cursor: progress;
    }
    .edit-status {
      margin: 0;
      min-height: 1.1rem;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .edit-status[data-tone="error"] {
      color: #ff8787;
    }
    .edit-status[data-tone="ok"] {
      color: #69db7c;
    }

    .section { margin-bottom: 1.5rem; }

    .section:last-child {
      margin-bottom: 0;
    }

    .section-header {
      margin-bottom: 1.25rem;
    }

    .section-title-row {
      display: inline-flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: 0.5rem;
      max-width: 100%;
    }

    .section-title {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
      white-space: nowrap;
    }

    .grid-row-group {
      margin-bottom: 1.1rem;
    }

    .grid-row-group:last-child {
      margin-bottom: 0;
    }

    .row-best-caption {
      margin-bottom: 0.5rem;
      padding: 0.35rem 0.5rem;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.04);
      border-left: 3px solid #6c757d;
      font-size: 0.75rem;
      color: #ced4da;
      line-height: 1.35;
      min-height: calc(0.7rem + 1.35 * 0.75rem);
    }

    .row-best-caption strong {
      color: #e9ecef;
      font-weight: 600;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      align-items: stretch;
      --equipment-card-min-height: 212px;
    }

    .card {
      --frame: #6b7280;
      --glow: rgba(255, 255, 255, 0.15);
      position: relative;
      background: var(--card);
      border-radius: 14px;
      border: none;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
      overflow: hidden;
      height: 100%;
    }

    .card-body { padding: 8px; }

    .meta {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: 0.75rem;
      margin-inline: -8px;
      padding: 4px 16px;
      margin-bottom: 0.55rem;
    }

    .level {
      justify-self: start;
      align-self: center;
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1;
      color: #dee2e6;
    }

    .card.legendary .level {
      color: #fb923c;
    }

    .card.eternal .level {
      color: #a78bfa;
    }

    .meta-power {
      justify-self: end;
      align-self: center;
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1;
      color: #fff;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .name-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--glow) 55%, var(--frame)) 0%,
        var(--frame) 100%
      );
      border-radius: 0;
      padding: 8px;
      box-sizing: border-box;
      text-align: left;
      font-size: 0.9rem;
      font-weight: 700;
      line-height: 1.15;
      color: #0f1114;
      text-shadow: 0 1px 0 color-mix(in srgb, var(--glow) 40%, transparent);
    }

    .name-bar-icon-wrap {
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.38);
      border-radius: 10px;
    }

    .name-bar-icon {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      object-fit: contain;
      image-rendering: -webkit-optimize-contrast;
    }

    .name-bar-text-wrap {
      flex: 1;
      min-width: 0;
      display: flex;
      align-items: center;
      min-height: calc(1.15em * 2);
    }

    .name-bar-text {
      width: 100%;
      line-height: 1.15;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      text-overflow: ellipsis;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .card.eternal .name-bar {
      color: #1e1b4b;
    }

    .card.legendary .name-bar {
      color: #422006;
    }

    .stat-primary-block {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      border-radius: 8px;
      min-height: 2.5rem;
      padding: 0 0.55rem;
      margin-bottom: 0.5rem;
      background: rgba(0, 0, 0, 0.15);
    }

    .stat-primary-block .label {
      color: #ced4da;
      font-weight: 700;
      font-size: 0.78rem;
      line-height: 1.15;
      align-self: center;
    }

    .stat-primary-block .value {
      color: #fff;
      font-weight: 700;
      font-size: 0.88rem;
      line-height: 1.15;
      text-align: right;
      align-self: center;
    }

    .stats {
      list-style: none;
      border-radius: 8px;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.15);
    }

    .stats li {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: 0.5rem;
      min-height: 2rem;
      padding: 0 0.55rem;
      font-size: 0.72rem;
      border-bottom: 1px solid var(--divider);
    }

    .stats li .label,
    .stats li .value {
      line-height: 1.15;
      align-self: center;
    }

    .stats li:last-child { border-bottom: none; }

    .stats .label {
      color: #ced4da;
      font-weight: 500;
      justify-self: start;
    }

    .stats .value {
      color: #fff;
      font-weight: 600;
      text-align: right;
      justify-self: end;
    }

    .card.eternal .stat-row-best .label,
    .card.eternal .stat-row-best .value {
      color: #a78bfa;
      font-weight: 600;
    }

    .card.legendary .stat-row-best .label,
    .card.legendary .stat-row-best .value {
      color: #fdba74;
      font-weight: 600;
    }

    .grid-empty {
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: stretch;
      min-height: 0;
      height: 100%;
      border-radius: 14px;
      border: 1px dashed rgba(255, 255, 255, 0.06);
      background: rgba(0, 0, 0, 0.12);
    }

    .grid:not(:has(.card)) .grid-empty {
      min-height: var(--equipment-card-min-height);
    }

    .grid-empty-plate {
      width: 72px;
      height: 72px;
      object-fit: contain;
      opacity: 0.22;
      pointer-events: none;
      user-select: none;
    }

    .summary-hover {
      position: relative;
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }

    .summary-float {
      position: fixed;
      left: 1rem;
      right: auto;
      bottom: var(--dock-bottom);
      z-index: 1002;
    }

    .summary-popover {
      position: absolute;
      left: 0;
      right: auto;
      bottom: calc(100% + 0.55rem);
      top: auto;
      z-index: 100;
      width: max-content;
      min-width: 11rem;
      max-width: min(16rem, calc(100vw - 2rem));
      padding: 0;
      background: rgba(22, 24, 28, 0.72);
      backdrop-filter: blur(20px) saturate(1.2);
      -webkit-backdrop-filter: blur(20px) saturate(1.2);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition:
        opacity 0.16s ease,
        transform 0.16s ease,
        visibility 0.16s;
      pointer-events: none;
    }

    .summary-hover:hover .summary-popover,
    .summary-hover:focus-within .summary-popover {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .summary-table-wrap {
      max-height: min(50vh, 20rem);
      overflow-x: auto;
      overflow-y: auto;
      padding: 0.35rem 0.25rem;
    }

    .summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.75rem;
      line-height: 1.35;
    }

    .summary-table td {
      padding: 0.35rem 0.5rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      vertical-align: middle;
    }

    .summary-table td.stat-label {
      font-weight: 500;
      color: #adb5bd;
      white-space: nowrap;
      padding-right: 0.75rem;
    }

    .summary-table td.stat-total {
      font-weight: 600;
      color: #f1f3f5;
      white-space: nowrap;
      text-align: right;
      padding-left: 0.5rem;
      padding-right: 0.35rem;
      font-variant-numeric: tabular-nums;
    }

    .summary-table tbody tr:last-child td {
      border-bottom: none;
    }

    .page-load-error {
      margin: 0 0 1rem;
      padding: 0.65rem 0.85rem;
      border-radius: 10px;
      border: 1px solid rgba(248, 113, 113, 0.35);
      background: rgba(127, 29, 29, 0.25);
      color: #fecaca;
      font-size: 0.8125rem;
    }
  </style>
</head>
<body>
  <div
    class="mode-toggle glass-chip"
    id="setModeToggle"
    role="group"
    aria-label="Set mode"
    hidden
  ></div>
  <button
    type="button"
    class="dock-fab glass-chip edit-fab"
    id="editModeToggle"
    aria-pressed="false"
    aria-label="Edit mode"
    title="Edit mode — tap a card to edit"
    hidden
  >
    <i data-lucide="pencil" aria-hidden="true"></i>
  </button>
  <dialog class="edit-dialog" id="editDialog"></dialog>
  <div class="page" id="equipmentPage">
    <div class="page-loading" role="status" aria-label="Loading">
      <span class="page-loading-spinner" aria-hidden="true"></span>
    </div>
  </div>
  <nav class="set-tabs" aria-label="Select equipment set">
    <div class="set-tabs-list glass-chip" id="setTabList" role="tablist"></div>
  </nav>
  <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
  <script type="application/json" id="equipment-sets-data"><%= equipment_sets_json %></script>
  <script type="application/json" id="equipment-sheets-config"><%= sheets_config_json %></script>
  <script type="module" src="assets/js/main.mjs"></script>
</body>
</html>
